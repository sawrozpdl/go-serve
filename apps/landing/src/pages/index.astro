---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import NightShift from '../components/sections/NightShift.astro';
import Connector from '../components/sections/Connector.astro';
import StatsStrip from '../components/sections/StatsStrip.astro';
import FeatureTour from '../components/sections/FeatureTour.astro';
import Playground from '../components/sections/Playground.astro';
import QrMenu from '../components/sections/QrMenu.astro';
import Analytics from '../components/sections/Analytics.astro';
import Reliability from '../components/sections/Reliability.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import PricingTeaser from '../components/sections/PricingTeaser.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { FAQS } from '../data/faq';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base jsonLd={[faqLd]}>
  <Hero />
  <StatsStrip />
  {/* The money-truth story leads, because it is the reason to choose this over
      any other till. Everything below it — the floor, the kitchen, offline — is
      reassurance that service will not break, which matters enormously but is
      not what makes someone switch. */}
  <NightShift />
  <Connector />
  <FeatureTour />
  <Playground />
  <QrMenu />
  <Analytics />
  <Reliability />
  <Testimonials />
  <PricingTeaser />
  <Faq />
  <FinalCta />
</Base>
