---
import Base from '../../layouts/Base.astro';
import CtaButton from '../../components/CtaButton.astro';
import { getCollection, render } from 'astro:content';
import { withBase, BRAND } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const canonical = new URL(withBase(`/blog/${post.id}`), Astro.site);
const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: BRAND.name },
  mainEntityOfPage: canonical.href,
  keywords: post.data.tags.join(', '),
};
---

<Base
  title={`${post.data.title} | ${BRAND.name}`}
  description={post.data.description}
  jsonLd={[blogLd]}
>
  <article class="post">
    <header class="post-head">
      <div class="container narrow">
        <a class="post-back" href={withBase('/blog')}>← All posts</a>
        <div class="post-tags">
          {post.data.tags.map((t) => <span class="tag tag-amber">{t}</span>)}
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-meta">
          By {post.data.author} · {fmt(post.data.publishDate)}
          {post.data.readingTime && <span> · {post.data.readingTime} min read</span>}
        </p>
      </div>
    </header>

    <div class="container narrow">
      <div class="prose post-body">
        <Content />
      </div>

      <aside class="post-cta card">
        <div>
          <h2>Run all of this in one app.</h2>
          <p>GoServe handles orders, billing, inventory and the daily close — built for cafes in Nepal.</p>
        </div>
        <div class="post-cta-actions">
          <CtaButton action="trial">Start free trial</CtaButton>
          <a class="btn btn-ghost" href={withBase('/pricing')}>See pricing</a>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .post-head {
    padding-block: clamp(40px, 6vw, 72px) var(--space-6);
    text-align: center;
  }
  .post-head .narrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .post-back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-300);
    text-decoration: none;
  }
  .post-back:hover {
    color: var(--amber-fg);
  }
  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .post-title {
    font-size: var(--display-lg);
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-300);
  }
  .post-body {
    margin: 0 auto;
    padding-block: var(--space-6) var(--space-8);
  }
  .post-cta {
    margin: 0 auto var(--section-pad);
    max-width: var(--container-narrow);
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    background: var(--brand-wash-amber);
    border-color: var(--brand-wash-amber-border);
  }
  .post-cta h2 {
    font-size: 1.5rem;
  }
  .post-cta p {
    color: var(--ink-200);
    margin-top: 6px;
    max-width: 46ch;
  }
  .post-cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
