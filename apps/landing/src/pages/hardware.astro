---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaButton from '../components/CtaButton.astro';
import { withBase } from '../data/site';

const groups = [
  {
    key: 'devices',
    title: 'Runs on what you own',
    lede: 'No proprietary terminals. GoServe installs as an app on the devices already in your cafe.',
    items: [
      'Android & iOS phones and tablets',
      'Any laptop or desktop with a modern browser',
      'Installs as a PWA — add to home screen, opens full-screen',
      'Works offline and syncs when the wifi returns',
    ],
  },
  {
    key: 'printing',
    title: 'Printing, if you want it',
    lede: 'Print kitchen dockets and customer receipts — or skip paper entirely and run off screens.',
    items: [
      'Most 58mm & 80mm thermal receipt printers',
      'Network / Wi-Fi printers per outlet or station',
      'Kitchen docket on send, receipt on settle',
      'Silent printing via kiosk / RawBT for hands-free service',
    ],
  },
  {
    key: 'payments',
    title: 'Every way Nepal pays',
    lede: 'Take payment however your customers want, and see it all reconciled in one place.',
    items: [
      'eSewa & Khalti QR payments',
      'Cash, card and bank transfer',
      'Customer credit / house tabs',
      '13% VAT and service charge handled automatically',
    ],
  },
];
---

<Base
  title="Hardware & payments — GoServe"
  description="GoServe runs on the phones, tablets and laptops you already own, prints to common thermal printers, and takes eSewa, Khalti, cash, card and credit — all reconciled in one place."
>
  <PageHeader
    eyebrow="Hardware & payments"
    title="Works with what you already have."
    accent="what you already have."
    lede="No expensive terminals, no lock-in. Start on your phone today and add printers or tablets whenever you’re ready."
  />

  <section class="hw">
    <div class="container">
      <div class="hw-grid">
        {
          groups.map((g) => (
            <article class="hw-card card" data-reveal>
              <div class={`hw-ic hw-ic-${g.key}`} aria-hidden="true">
                {g.key === 'devices' && (
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="14" height="12" rx="2" /><path d="M2 20h14" /><rect x="17" y="9" width="5" height="11" rx="1.5" /></svg>
                )}
                {g.key === 'printing' && (
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6" /><rect x="4" y="9" width="16" height="7" rx="2" /><path d="M7 16h10v5H7z" /></svg>
                )}
                {g.key === 'payments' && (
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18" /></svg>
                )}
              </div>
              <h2>{g.title}</h2>
              <p class="hw-lede">{g.lede}</p>
              <ul>
                {g.items.map((i) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    {i}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="hw-note">
        <p>
          Not sure a printer or device will work? <a href={withBase('/contact')}>Ask us</a> — we’ll check
          before you buy anything.
        </p>
        <CtaButton action="trial" size="lg">Start free trial</CtaButton>
      </div>
    </div>
  </section>
</Base>

<style>
  .hw {
    padding-block: clamp(16px, 3vw, 40px) var(--section-pad);
  }
  .hw-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .hw-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hw-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    color: var(--amber-fg);
    background: var(--brand-wash-amber);
    border: 1px solid var(--brand-wash-amber-border);
    margin-bottom: var(--space-2);
  }
  .hw-card h2 {
    font-size: 1.35rem;
  }
  .hw-lede {
    color: var(--ink-300);
    font-size: 0.95rem;
  }
  .hw-card ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hw-card li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--ink-100);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .hw-card li svg {
    color: var(--lime-fg);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .hw-note {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding: var(--space-6);
    border-top: 2px dashed var(--ink-600);
  }
  .hw-note p {
    color: var(--ink-200);
    font-size: var(--body-lg);
    max-width: 48ch;
  }
  .hw-note a {
    color: var(--amber-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 860px) {
    .hw-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
