---
/* Site CTA. Defaults to the primary "Start free trial" action (→ the app's
 * request-access flow). Pass `to` for an internal path (run through
 * withBase), `href` for an explicit URL, or `action` for a named target. */
import { SIGNUP_URL, LOGIN_URL, withBase } from '../data/site';

type Props = {
  ghost?: boolean;
  id?: string;
  /** Named target shortcut. */
  action?: 'trial' | 'login' | 'contact' | 'demo';
  /** Internal path (base-prefixed). Overrides `action`. */
  to?: string;
  /** Explicit absolute URL. Overrides `to` and `action`. */
  href?: string;
  size?: 'md' | 'lg';
};

const { ghost = false, id, action = 'trial', to, href, size = 'md' } = Astro.props;

const byAction: Record<NonNullable<Props['action']>, string> = {
  trial: SIGNUP_URL,
  login: LOGIN_URL,
  contact: withBase('/contact'),
  demo: withBase('/#playground'),
};

const resolved = href ?? (to ? withBase(to) : byAction[action]);
---

<a
  {id}
  href={resolved}
  class:list={['btn', ghost ? 'btn-ghost' : 'btn-primary', { 'btn-lg': size === 'lg' }]}
>
  <slot>Start free trial</slot>
</a>
