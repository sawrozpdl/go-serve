---
import SteamingCup from './SteamingCup.astro';
import CtaButton from './CtaButton.astro';
import { NAV_LINKS, LOGIN_URL, withBase, BRAND } from '../data/site';
---

<header class="site-header">
  <div class="container header-row">
    <a href={withBase('/')} class="brand" aria-label={`${BRAND.name} home`}>
      <SteamingCup size={26} />
      <span class="brand-name">{BRAND.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {NAV_LINKS.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="icon-btn theme-toggle"
        data-theme-toggle
        aria-label="Switch theme"
        title="Switch theme"
      >
        <svg class="ic ic-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="ic ic-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <a class="nav-login" href={LOGIN_URL}>Log in</a>
      <CtaButton id="header-cta" action="trial">Start free trial</CtaButton>
      <button
        type="button"
        class="icon-btn menu-btn"
        data-menu-toggle
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <svg class="ic ic-menu" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        <svg class="ic ic-x" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Mobile">
      {NAV_LINKS.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
      <a href={LOGIN_URL}>Log in</a>
    </nav>
    <CtaButton action="trial">Start free trial</CtaButton>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--ink-1000) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--hairline);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: 12px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink-50);
    letter-spacing: -0.01em;
  }
  .nav-desktop {
    display: flex;
    gap: clamp(14px, 2.4vw, 30px);
    margin-inline: auto;
  }
  .nav-desktop a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-200);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-desktop a:hover {
    color: var(--amber-fg);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }
  .nav-login {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-100);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-login:hover {
    color: var(--amber-fg);
  }
  .site-header :global(.btn) {
    padding: 9px 18px;
    font-size: 0.88rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--ink-700);
    background: var(--tint-1);
    color: var(--ink-100);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .icon-btn:hover {
    border-color: var(--amber-500);
    color: var(--amber-fg);
  }
  .ic {
    display: block;
  }
  /* Toggle shows the icon of the theme you'd switch TO. */
  .ic-sun {
    display: none;
  }
  :global([data-theme='dark']) .ic-sun {
    display: block;
  }
  :global([data-theme='dark']) .ic-moon {
    display: none;
  }
  .menu-btn {
    display: none;
  }
  .ic-x {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .ic-menu {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .ic-x {
    display: block;
  }

  .mobile-nav {
    border-top: 1px solid var(--hairline);
    padding: var(--space-5) clamp(20px, 4vw, 36px) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-nav nav a {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink-100);
    text-decoration: none;
    padding: 12px 4px;
    border-bottom: 1px solid var(--hairline);
  }
  .mobile-nav :global(.btn) {
    width: 100%;
  }

  @media (max-width: 860px) {
    .nav-desktop,
    .nav-login {
      display: none;
    }
    .site-header :global(#header-cta) {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;

    // Theme toggle — persist the explicit choice.
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('goserve-theme', next);
        } catch (e) {}
      });
    });

    // Mobile menu.
    var menuBtn = document.querySelector('[data-menu-toggle]');
    var panel = document.getElementById('mobile-nav');
    if (menuBtn && panel) {
      var setOpen = function (open) {
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        panel.hidden = !open;
      };
      menuBtn.addEventListener('click', function () {
        setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
      });
      panel.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setOpen(false); });
      });
      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
    }
  })();
</script>
