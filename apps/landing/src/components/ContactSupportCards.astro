---
/* Direct-contact cards — one per phone line, labelled by what the line is for,
 * plus a single shared inbox row. The number is the headline: it's the only
 * identifier on the card, so it carries the type. */
import { SUPPORT_LINES, CONTACT_EMAIL } from '../data/site';

const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('GoServe — hello')}`;
---

<div class="support-cards">
  {
    SUPPORT_LINES.map((l) => (
      <div class="support-card">
        <div class="support-info">
          <span class="support-role">{l.label}</span>
          <a class="support-number" href={`tel:${l.phone.replace(/\s+/g, '')}`}>{l.phone}</a>
        </div>
        <div class="support-actions">
          <a class="btn btn-ghost" href={`tel:${l.phone.replace(/\s+/g, '')}`}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
            Call
          </a>
        </div>
      </div>
    ))
  }

  <div class="support-card support-card--email">
    <div class="support-info">
      <span class="support-role">Email us</span>
      <a class="support-number" href={mailto}>{CONTACT_EMAIL}</a>
    </div>
    <div class="support-actions">
      <a class="btn btn-ghost" href={mailto}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        Email
      </a>
    </div>
  </div>
</div>

<style>
  .support-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .support-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-4) var(--space-5);
    background: var(--surface-card);
    border: 1px solid var(--ink-700);
    border-radius: var(--radius-md);
  }
  /* The shared inbox sits apart from the phone lines. */
  .support-card--email {
    margin-top: var(--space-2);
    background: none;
    border-style: dashed;
  }
  .support-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .support-role {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber-fg);
  }
  /* The number is the card's subject — mono, tabular, and big enough to read
     across a counter. */
  .support-number {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--ink-50);
    text-decoration: none;
    word-break: break-word;
  }
  .support-number:hover {
    color: var(--amber-fg);
  }
  .support-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .support-actions :global(.btn) {
    padding: 8px 14px;
    font-size: 0.85rem;
  }
</style>
