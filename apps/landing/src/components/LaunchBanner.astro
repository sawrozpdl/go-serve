---
/* Launch-offer announcement bar.
 *
 * Renders nothing at all when LAUNCH.active is false, so retiring the promotion
 * is a one-line change in data/plans.ts. Dismissal is remembered in
 * localStorage and applied before first paint, so a returning visitor who has
 * already closed it never sees it flash.
 */
import { LAUNCH } from '../data/plans';
import { withBase } from '../data/site';

/* Bump this when the offer changes — a new key re-shows the bar to people who
 * dismissed the previous one. */
const DISMISS_KEY = 'goserve-launch-2026';
---

{
  LAUNCH.active && (
    <aside class="launch-bar" data-launch-bar data-key={DISMISS_KEY}>
      <div class="container launch-row">
        <p class="launch-copy">
          <span class="launch-tag">Launch offer</span>
          <span class="launch-head">{LAUNCH.headline}</span>
          <span class="launch-sub">{LAUNCH.sub}</span>
        </p>
        <div class="launch-actions">
          <a class="launch-link" href={withBase('/pricing')}>See plans →</a>
          <button type="button" class="launch-x" data-launch-dismiss aria-label="Dismiss offer">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </aside>
  )
}

<style>
  /* Amber wash rather than a solid fill: it sits directly above the header, and a
     saturated band there fights the hero for attention. Both themes have these
     tokens, so it reads correctly light and dark. */
  .launch-bar {
    background: var(--warn-bg);
    border-bottom: 1px solid var(--warn-border);
  }
  .launch-bar[hidden] {
    display: none;
  }
  .launch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }
  .launch-copy {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    min-width: 0;
  }
  .launch-tag {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-brand);
    background: var(--amber-500);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
    white-space: nowrap;
  }
  .launch-head {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--amber-fg);
  }
  .launch-sub {
    font-size: var(--text-sm);
    color: var(--ink-300);
  }
  .launch-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 0 0 auto;
  }
  .launch-link {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber-fg);
    white-space: nowrap;
  }
  .launch-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-400);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .launch-x:hover {
    color: var(--ink-100);
    background: var(--tint-2);
  }

  /* On a phone the sub-line is the first thing to go — the headline and the link
     carry the offer on their own. */
  @media (max-width: 720px) {
    .launch-sub {
      display: none;
    }
    .launch-head {
      font-size: var(--text-md);
    }
  }
</style>

{
  LAUNCH.active && (
    <script is:inline>
      (function () {
        var bar = document.querySelector('[data-launch-bar]');
        if (!bar) return;
        var key = bar.getAttribute('data-key');
        // The bar ships visible so it still reaches visitors without JS; this
        // runs inline right after it in document order, before paint, and hides
        // it again for anyone who already dismissed it.
        try {
          if (localStorage.getItem(key) === 'dismissed') {
            bar.hidden = true;
            return;
          }
        } catch (e) {}
        var x = bar.querySelector('[data-launch-dismiss]');
        if (!x) return;
        x.addEventListener('click', function () {
          bar.hidden = true;
          try {
            localStorage.setItem(key, 'dismissed');
          } catch (e) {}
        });
      })();
    </script>
  )
}
