---
import SteamingCup from '../SteamingCup.astro';
import CtaButton from '../CtaButton.astro';
import BriefMockup from '../mockups/BriefMockup.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-stagger s1">
        <span class="live-dot" style="display:inline-block;margin-right:8px"></span>Point of sale with a night shift
      </p>
      <h1 id="hero-heading" class="hero-title hero-stagger s2">
        You know what you sold. Do you know <em class="display-accent">what you kept?</em>
      </h1>
      <p class="lede hero-stagger s3">
        GoServe runs your cafe all day, then closes your books overnight and emails you what it found —
        your real margin, anything that doesn't add up, and the one thing worth deciding today.
        Every number links to the rows it came from.
      </p>
      <div class="hero-ctas hero-stagger s4">
        <CtaButton id="hero-cta" />
        <a href="#night-shift" class="btn btn-ghost">See what it found ↓</a>
      </div>
      <p class="hero-note hero-stagger s5">Built for real cafes — running daily service since 2026.</p>
    </div>
    <div class="hero-visual hero-stagger s3" aria-hidden="false">
      <BriefMockup />
      <div class="hero-cup">
        <SteamingCup size={64} hero />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(64px, 9vw, 120px) clamp(40px, 6vw, 72px);
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .hero-title {
    /* A notch below --display-xl. This headline is a full sentence and a
     * question rather than a three-word phrase, so at the shared display size it
     * ran to five lines and pushed the call to action below the fold on a
     * laptop. The question is worth more than the extra type size. */
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    text-wrap: balance;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .hero-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-300);
    letter-spacing: 0.06em;
  }
  .hero-visual {
    position: relative;
    transform: rotate(0.8deg);
  }
  .hero-cup {
    position: absolute;
    top: -34px;
    right: -10px;
    filter: drop-shadow(0 12px 36px rgba(var(--amber-glow), 0.3));
  }
  /* Staggered load reveal — one orchestrated moment, CSS only. */
  .hero-stagger {
    animation: fadeUp 700ms var(--ease-spring) both;
  }
  .s1 { animation-delay: 60ms; }
  .s2 { animation-delay: 160ms; }
  .s3 { animation-delay: 280ms; }
  .s4 { animation-delay: 400ms; }
  .s5 { animation-delay: 520ms; }
  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      transform: none;
    }
    .hero-cup {
      top: -28px;
      right: 4px;
    }
  }
</style>
