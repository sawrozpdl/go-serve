---
/* Testimonials — renders real quotes in production, sample quotes only in
 * dev (for design validation). If there are no items to show, the section
 * renders nothing at all, so production stays honest until real quotes
 * land. */
import SectionShell from '../SectionShell.astro';
import { REAL_TESTIMONIALS, SAMPLE_TESTIMONIALS } from '../../data/testimonials';

const isDev = import.meta.env.DEV;
const items = REAL_TESTIMONIALS.length ? REAL_TESTIMONIALS : isDev ? SAMPLE_TESTIMONIALS : [];
const showSampleTag = isDev && !REAL_TESTIMONIALS.length && items.length > 0;
---

{
  items.length > 0 && (
    <SectionShell
      id="loved"
      eyebrow="Loved by cafes"
      heading="From the people behind the counter."
      accent="behind the counter."
      center
    >
      {showSampleTag && (
        <p class="sample-note" role="note">
          Sample content — visible in dev only, never in production. Swap in real quotes in
          <code>src/data/testimonials.ts</code>.
        </p>
      )}
      <ul class="quote-grid">
        {items.map((t) => (
          <li class="quote card" data-reveal>
            {t.rating && (
              <div class="quote-stars" aria-label={`${t.rating} out of 5`}>
                {Array.from({ length: t.rating }).map(() => (
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.8 5.9 21.4l1.4-6.8L2.2 9.9l6.9-.8z" /></svg>
                ))}
              </div>
            )}
            <blockquote>“{t.quote}”</blockquote>
            <footer class="quote-by">
              <span class="quote-name">{t.name}</span>
              <span class="quote-cafe">
                {t.role} · {t.cafe}
              </span>
            </footer>
          </li>
        ))}
      </ul>
    </SectionShell>
  )
}

<style>
  .sample-note {
    max-width: 620px;
    margin: 0 auto var(--space-6);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--warn-fg-tile);
    background: var(--warn-bg);
    border: 1px dashed var(--warn-border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .sample-note code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .quote-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    text-align: left;
  }
  .quote {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .quote-stars {
    display: flex;
    gap: 2px;
    color: var(--amber-500);
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--ink-50);
  }
  .quote-by {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
  }
  .quote-name {
    font-weight: 600;
    color: var(--ink-100);
  }
  .quote-cafe {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-300);
  }
  @media (max-width: 860px) {
    .quote-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
