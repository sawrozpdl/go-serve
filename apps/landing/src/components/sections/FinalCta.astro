---
import CtaButton from '../CtaButton.astro';
import SteamingCup from '../SteamingCup.astro';
import { TRIAL_COPY } from '../../data/plans';
---

<section class="final" aria-labelledby="final-heading">
  <div class="container final-inner">
    <SteamingCup size={56} hero />
    <h2 id="final-heading">Your first order is <em class="display-accent">five minutes away.</em></h2>
    <p class="lede">
      Start your {' '}free 30-day trial and we'll set your cafe up personally — menu, tables, team, and all.
      No card, no contract.
    </p>
    <div class="final-ctas">
      <CtaButton id="final-cta" action="trial" size="lg">Start free trial</CtaButton>
      <CtaButton action="contact" ghost size="lg">Talk to us first</CtaButton>
    </div>
    <p class="final-note">{TRIAL_COPY}</p>
  </div>
</section>

<style>
  .final {
    padding-block: var(--section-pad);
    position: relative;
    overflow: hidden;
  }
  .final::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% 110%, rgba(var(--amber-glow), 0.12), transparent 65%);
    pointer-events: none;
  }
  .final-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  .final h2 {
    font-size: var(--display-lg);
    max-width: 18ch;
  }
  .final-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }
  .final-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-300);
  }
</style>
