---
import SectionShell from '../SectionShell.astro';

const points = [
  {
    title: 'Your cafe in your pocket',
    body: 'See live sales and today’s numbers from your phone — at the cafe, at home, or on the way there. You’re never in the dark.',
    tag: 'Live dashboard',
  },
  {
    title: 'Never lose a sale',
    body: 'Every order is saved the moment it’s taken. A dead battery, a dropped connection, a crashed device — none of it costs you the day.',
    tag: 'Always saved',
  },
  {
    title: 'Split, merge & move tabs',
    body: 'Split a bill between friends, merge two tables into one, or move a tab across the floor — all in a tap, mid-service.',
    tag: 'Tabs & tables',
  },
  {
    title: 'Roles your team understands',
    body: 'Waiters add and send. Managers discount and void. Owners see everything. Granular permissions ship out of the box and bend to your cafe.',
    tag: 'Role-based access',
  },
  {
    title: 'Every action, accounted for',
    body: 'A full audit timeline records who voided, discounted, or settled what — trust built into the system instead of resting on memory.',
    tag: 'Audit trail',
  },
  {
    title: 'Your data stays yours',
    body: 'Export everything whenever you want. Tenant isolation is enforced at the database layer, not just promised in the brochure.',
    tag: 'Isolation + export',
  },
];
---

<SectionShell
  id="reliability"
  eyebrow="Built for service"
  heading="The details that save your night."
  accent="save your night."
  lede="The small things you only notice when they’re missing — the ones that hold up on a full Saturday. We obsess over them."
  center
>
  <div class="rel-grid">
    {
      points.map((p) => (
        <div class="rel-card" data-reveal>
          <span class="rel-tag">{p.tag}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))
    }
  </div>
</SectionShell>

<style>
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .rel-card {
    background: var(--surface-card);
    border: 1px solid var(--ink-700);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .rel-tag {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime-fg);
  }
  .rel-card h3 {
    font-size: 1.25rem;
  }
  .rel-card p {
    color: var(--ink-200);
    font-size: var(--text-lg);
    line-height: 1.65;
  }
  @media (max-width: 860px) {
    .rel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .rel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
