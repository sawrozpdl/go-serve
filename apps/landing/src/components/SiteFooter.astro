---
import SteamingCup from './SteamingCup.astro';
import { FOOTER_NAV, CONTACT_EMAIL, withBase, BRAND } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={withBase('/')} class="footer-mark" aria-label={`${BRAND.name} home`}>
        <SteamingCup size={26} />
        <span class="footer-name">{BRAND.name}</span>
      </a>
      <p class="footer-tag">{BRAND.tagline}</p>
      <a class="footer-mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>

    {
      FOOTER_NAV.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <p class="footer-col-title">{col.title}</p>
          {col.links.map((l) => (
            <a href={l.href.startsWith('http') ? l.href : withBase(l.href)}>{l.label}</a>
          ))}
        </nav>
      ))
    }
  </div>

  <div class="container footer-base">
    <p>© {year} {BRAND.name}. Brewed with care in {BRAND.city}.</p>
    <p class="footer-made">🇳🇵 Built for cafes in {BRAND.country}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-9) var(--space-6);
    background: var(--ink-900);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-7);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 30ch;
  }
  .footer-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink-50);
  }
  .footer-tag {
    color: var(--ink-300);
    font-size: var(--text-lg);
  }
  .footer-mail {
    color: var(--amber-fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .footer-mail:hover {
    text-decoration: underline;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: var(--space-1);
  }
  .footer-col a {
    color: var(--ink-200);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer-col a:hover {
    color: var(--amber-fg);
  }
  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
    color: var(--ink-300);
    font-size: var(--text-sm);
  }
  .footer-made {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
