---
/* Full pricing grid with a yearly/monthly toggle. Both price strings are
 * rendered server-side; a tiny script flips [data-cycle] on the wrapper so
 * there's no hydration cost and it works before/without JS (defaults to
 * yearly). */
import CtaButton from './CtaButton.astro';
import { PLANS, formatRs, yearlySavingsPct } from '../data/plans';

const rows = PLANS.map((p) => {
  const pct = yearlySavingsPct(p);
  return {
    ...p,
    yearlyPrice: p.yearly != null ? formatRs(p.yearly) : 'Custom',
    yearlyPeriod: p.yearly != null ? '/year' : '',
    yearlySub:
      p.yearly != null && p.monthly != null
        ? `≈ ${formatRs(Math.round(p.yearly / 12))}/mo · billed yearly`
        : 'Tailored to your group',
    monthlyPrice: p.monthly != null ? formatRs(p.monthly) : 'Custom',
    monthlyPeriod: p.monthly != null ? '/month' : '',
    monthlySub: p.monthly != null ? 'billed monthly' : 'Tailored to your group',
    savePct: pct,
  };
});
---

<div class="pricing" data-cycle="yearly">
  <div class="cycle" role="group" aria-label="Billing period">
    <button type="button" class="cycle-btn" data-cycle-btn="yearly" aria-pressed="true">
      Yearly
      <span class="cycle-save">save 2 months</span>
    </button>
    <button type="button" class="cycle-btn" data-cycle-btn="monthly" aria-pressed="false">Monthly</button>
  </div>

  <div class="plan-grid">
    {
      rows.map((p) => (
        <article class:list={['plan card', { featured: p.featured }]} data-reveal>
          {p.featured && <span class="plan-flag">Most popular</span>}
          <header class="plan-head">
            <h3 class="plan-name">{p.name}</h3>
            <p class="plan-tagline">{p.tagline}</p>
          </header>

          <div class="plan-price">
            <div class="price-line" data-when="yearly">
              <span class="price-amt num">{p.yearlyPrice}</span>
              <span class="price-per">{p.yearlyPeriod}</span>
            </div>
            <div class="price-line" data-when="monthly" hidden>
              <span class="price-amt num">{p.monthlyPrice}</span>
              <span class="price-per">{p.monthlyPeriod}</span>
            </div>
            <p class="price-sub" data-when="yearly">{p.yearlySub}</p>
            <p class="price-sub" data-when="monthly" hidden>{p.monthlySub}</p>
          </div>

          <CtaButton action={p.cta.action} ghost={!p.featured}>
            {p.cta.label}
          </CtaButton>

          <p class="plan-summary">{p.summary}</p>

          {p.inherits && <p class="plan-inherits">{p.inherits}</p>}
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</div>

<style>
  .cycle {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin: 0 auto var(--space-8);
    background: var(--ink-900);
    border: 1px solid var(--ink-700);
    border-radius: var(--radius-pill);
    justify-self: center;
  }
  .pricing {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cycle-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-300);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    padding: 8px 20px;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .cycle-btn[aria-pressed='true'] {
    color: var(--on-brand);
    background: var(--amber-500);
  }
  .cycle-save {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lime-fg);
  }
  .cycle-btn[aria-pressed='true'] .cycle-save {
    color: var(--on-brand);
    opacity: 0.75;
  }

  /* Equal-width, equal-height cards. On a wide screen all three fit and
   * 1fr grows them to fill the container; when it gets tighter the row
   * scrolls horizontally rather than shrinking or reflowing unevenly. */
  .plan-grid {
    display: grid;
    grid-auto-flow: column;
    /* Three columns at 1fr fill the ~1048px container comfortably; narrower
     * viewports hit the 230px floor and the row scrolls instead of shrinking. */
    grid-auto-columns: minmax(230px, 1fr);
    gap: var(--space-4);
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    /* room so the featured flag + focus rings aren't clipped by overflow-y */
    padding: 16px 2px 8px;
    margin-inline: -2px;
  }
  .plan {
    position: relative;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    scroll-snap-align: start;
  }
  .plan.featured {
    border-color: var(--amber-500);
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--amber-500);
  }
  .plan-flag {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-brand);
    background: var(--amber-500);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .plan-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .plan-name {
    font-size: 1.5rem;
  }
  .plan-tagline {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-fg);
  }
  .plan-price {
    min-height: 74px;
  }
  .price-line {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .price-line[hidden] {
    display: none;
  }
  .price-amt {
    font-size: 2.1rem;
    font-weight: 600;
    color: var(--ink-50);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .price-per {
    color: var(--ink-300);
    font-size: 0.95rem;
  }
  .price-sub {
    margin-top: 4px;
    font-size: var(--text-sm);
    color: var(--ink-300);
  }
  .price-sub[hidden] {
    display: none;
  }
  .plan :global(.btn) {
    width: 100%;
  }
  .plan-summary {
    font-size: var(--text-sm);
    color: var(--ink-300);
    min-height: 2.6em;
  }
  .plan-inherits {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-400);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--ink-600);
  }
  .plan-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--ink-200);
    line-height: 1.45;
  }
  .plan-features svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--lime-fg);
  }

  .plan-grid::-webkit-scrollbar {
    height: 8px;
  }
  .plan-grid::-webkit-scrollbar-thumb {
    background: var(--ink-600);
    border-radius: var(--radius-pill);
  }
  .plan-grid::-webkit-scrollbar-track {
    background: transparent;
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.pricing').forEach(function (root) {
      var btns = root.querySelectorAll('[data-cycle-btn]');
      function apply(cycle) {
        root.setAttribute('data-cycle', cycle);
        btns.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-cycle-btn') === cycle));
        });
        root.querySelectorAll('[data-when]').forEach(function (el) {
          el.hidden = el.getAttribute('data-when') !== cycle;
        });
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          apply(b.getAttribute('data-cycle-btn'));
        });
      });
    });
  })();
</script>
